# Server-side only; never expose secrets via NEXT_PUBLIC_ or VITE_ variables.
LLM_PROVIDER=classroom-fixture
# Coze Coding SDK mode requires matching integration endpoints and credentials.
# LLM_PROVIDER=coze
COZE_WORKLOAD_IDENTITY_API_KEY=
COZE_INTEGRATION_BASE_URL=
COZE_INTEGRATION_MODEL_BASE_URL=
LLM_MODEL=
# OpenAI-compatible alternative:
# LLM_PROVIDER=openai-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Legacy /api/skill DeepSeek-compatible endpoint:
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
